fn print_cells(cells: [bool], width: int, height: int)
{
	call print("+")
	let x: int = 0
	while x < width
	{
		call print("--")
		set x = x + 1
	}
	call print("+")
	call print_nl()

	let y: int = 0
	while y < height
	{
		call print("|")
		set x = 0
		while x < width
		{
			if cells[x + y*width]
			{
				call print("[]")
			}
			else
			{
				call print("  ")
			}
			set x = x + 1
		}
		call print("|")
		call print_nl()
		set y = y + 1
	}

	call print("+")
	set x = 0
	while x < width
	{
		call print("--")
		set x = x + 1
	}
	call print("+")
	call print_nl()
}

fn get_cell(cells: [bool], width: int, height: int, x: int, y: int) -> bool
{
	set x = (x + width) % width
	set y = (y + height) % height
	return cells[x + y*width]
}

fn count_neighbors(cells: [bool], width: int, height: int, x: int, y: int) -> int
{
	let result: int = 0
	if get_cell(cells, width, height, x - 1, y - 1) set result = result + 1
	if get_cell(cells, width, height, x - 1, y + 0) set result = result + 1
	if get_cell(cells, width, height, x - 1, y + 1) set result = result + 1
	if get_cell(cells, width, height, x + 0, y - 1) set result = result + 1
	if get_cell(cells, width, height, x + 0, y + 1) set result = result + 1
	if get_cell(cells, width, height, x + 1, y - 1) set result = result + 1
	if get_cell(cells, width, height, x + 1, y + 0) set result = result + 1
	if get_cell(cells, width, height, x + 1, y + 1) set result = result + 1
	return result
}

fn next_iteration(cells: [bool], width: int, height: int, next_cells: [bool])
{
	let y: int = 0
	let x: int = 0
	while y < height
	{
		set x = 0
		while x < width
		{
			set next_cells[x + y*width] = false
			let num_neighbors: int = count_neighbors(cells, width, height, x, y)
			if cells[x + y*width]
			{
				if num_neighbors >= 2 if num_neighbors <= 3 set next_cells[x + y*width] = true
			}
			else
			{
				if num_neighbors == 3 set next_cells[x + y*width] = true
			}
			set x = x + 1
		}
		set y = y + 1
	}
}

fn main() -> int
{
	let width:  int = 8
	let height: int = 8
	let iterations: int = 12

	let cells: [bool] = alloc(width * height)
	set cells[2 + 1*width] = true
	set cells[3 + 2*width] = true
	set cells[1 + 3*width] = true
	set cells[2 + 3*width] = true
	set cells[3 + 3*width] = true

	let next_cells: [bool] = alloc(width * height)
	let iter: int = 0
	while iter < iterations
	{
		call print("Iteration: ")
		call print_int(iter)
		call print_nl()
		call print_cells(cells, width, height)
		call print_nl()

		call next_iteration(cells, width, height, next_cells)

		let temp: [bool] = cells
		set cells = next_cells
		set next_cells = temp

		set iter = iter + 1
	}

	call print("Iteration: ")
	call print_int(iter)
	call print_nl()
	call print_cells(cells, width, height)
	call print_nl()

	return 0
}
